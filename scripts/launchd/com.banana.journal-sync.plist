<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana.journal-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio/scripts/launchd/run.sh</string>
    <string>journal-sync</string>
  </array>
  <!-- 신규 보유 종목에 포지션저널 스텁 자동 append: 매일 09:30 (멱등 — 기존 종목 skip). 전제는 빈칸(미작성)이나 즉시 risk-b 감시 대상이 됨 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Stockproject/banana-portfolio</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio/journal-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio/journal-sync.log</string>
</dict>
</plist>
