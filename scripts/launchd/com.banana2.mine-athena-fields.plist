<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.mine-athena-fields</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Pantheon/Repos/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>mine-athena-fields</string>
    <string>--reclassify</string>
    <string>--kind=all</string>
    <string>--include-unclassified</string>
    <string>--since=2023-01-01</string>
    <string>--limit=100</string>
  </array>
  <!-- 매일 06:30 KST — 05:00 밤 점검 뒤. 미네 통화·녹음 감정 v1.0 재판단(2026-10-31 오너 "-mj 병합·launchd 등록 진행"):
       Claude 기록마다 두 번, 하루 100개(호출 200번) 상한, 쿨다운 가드, 2023년~ 먼저(F-2). 두 답이 갈리면 애매함 → 검수 시트.
       최근 2일 노트는 전사가 더 붙을 수 있어 기다린다. 텔레그램 발신 없음. 2016~2022년 백필은 오너가 따로 정한다. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Pantheon/Repos/banana-portfolio-v2</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/mine-athena-fields.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/mine-athena-fields.log</string>
</dict>
</plist>
