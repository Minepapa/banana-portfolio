<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.media-transcribe</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Pantheon/Repos/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>media-transcribe</string>
  </array>
  <key>StartCalendarInterval</key>
  <!-- 매일 01:00(음성 블록, 2026-10-18 시간표 개편). 50분은 다음 파일 시작 전 확인하는 회차 예산이며,
       이미 시작한 파일은 03시 이후에 끝날 수 있다.
       사진 기억 구슬 02:20 예정 잡(별도 브랜치)과는 CPU만 겹치며 잠금 충돌은 없다. -->
  <array>
    <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Pantheon/Repos/banana-portfolio-v2</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/media-transcribe.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/media-transcribe.log</string>
</dict>
</plist>
