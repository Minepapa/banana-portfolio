<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana.realtime-quotes</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio/scripts/launchd/run.sh</string>
    <string>realtime-quotes</string>
  </array>
  <!-- 보유 국내종목 실시간 시세(한투 KIS): 30초 간격. run.sh가 평일 09:00-15:30 KST 외엔
       skip. KIS 크리덴셜 미설정 시 잡 자체가 정상 스킵(오류 아님). -->
  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Stockproject/banana-portfolio</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio/realtime-quotes.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio/realtime-quotes.log</string>
</dict>
</plist>
