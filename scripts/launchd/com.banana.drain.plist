<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana.drain</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio/scripts/launchd/run.sh</string>
    <string>drain</string>
  </array>
  <!-- 평가 큐 자동 드레인: ~3시간 간격 고정 시각. risk-b(월 03:00)·weekly(일 03:00)·
       risk-d(평일 16:30) 충돌 시간대(03, 15~16)를 피해 quota 경쟁 완화. -->
