<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana.risk-d</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio/scripts/launchd/run.sh</string>
    <string>risk-d</string>
  </array>
  <!-- 거시 리스크: 평일(월~금) 16:30 (KRX 마감 15:30 + 버퍼 — 당일 종가로 판단해 다음 개장 전 알림 보장) -->
