<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.reconcile-irp-executions</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>reconcile-irp-executions</string>
  </array>
  <!-- 평일 15:50 KST(2026-09-03 신설, 마이그레이션 2단계) — KIS 퇴직연금 체결조회
       (TTTC2201R)로 IRP 당일 체결을 직접 폴링해 Facts/Ledger/Executions에 기록.
       ⚠️ 실측 확인(2026-09-03): 이 API는 장중엔 빈 응답만 반환하고 장마감(15:30)
       이후에야 데이터가 뜨는 것으로 보임(잔고 API는 체결 즉시 반영되는 것과 대조적) —
       15:50이면 장마감 후 20분 여유. update-holdings-from-executions(16:05)보다
       먼저 돌아야 그날 체결을 그날 안에 보유수량에 반영할 수 있다. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>50</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Stockproject/banana-portfolio-v2</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/reconcile-irp-executions.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/reconcile-irp-executions.log</string>
</dict>
</plist>
