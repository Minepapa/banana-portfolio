<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.risk-b-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>risk-b-monitor</string>
  </array>
  <!-- 매월 1일 09:00 KST(2026-08-14, project-v2-redesign.md 최우선 미해결 항목 해소) —
       v1 risk-b.plist는 주1회였지만, 이 잡이 비교하는 기준선(State/Baselines)이 분기
       실적 발표 때만 바뀌는 데이터라 그보다 훨씬 자주 재확인해도 "지난달과 동일"만
       반복하는 낭비다(오너 확인). 월 1회면 분기 안에도 재확인 기회가 3번 있어 충분.
       Day 필드가 주말이어도 펀더멘털 비교라 시장 개장 여부와 무관하게 실행 가능. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Stockproject/banana-portfolio-v2</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/risk-b-monitor.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/risk-b-monitor.log</string>
</dict>
</plist>
