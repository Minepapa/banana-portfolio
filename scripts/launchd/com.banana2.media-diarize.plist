<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.media-diarize</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Pantheon/Repos/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>media-diarize</string>
  </array>
  <key>StartCalendarInterval</key>
  <!-- 매일 03:05·04:05, 전사 완료 파일을 화자 분리한다. 새 통화 시작은 회차당 45분까지. -->
