<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.sync-firestore-mirror</string>
  <!-- 10분 간격(2026-08-25, 오너 지시 — 30분→10분 단축, update-holdings-prices와
       동일 주기 유지). 원래 2026-08-19 신설 당시엔 코드(Vault→mirror 빌더, src/
       App.jsx 구독)는 Phase 6에서 이미 완성돼 있었지만 이 잡을 실제로 도는 스케줄이
       어디에도 없어서(launchd에도 GitHub Actions에도) 배포된 대시보드가 최신 Vault
       상태를 반영 못 하고 있었던 걸 오너가 발견해 신설. mirrorFreshness.js의 2시간
       임계값(오래된 데이터 경고 배너)보다 여전히 충분히 촘촘하다. -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>sync-firestore-mirror</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Stockproject/banana-portfolio-v2</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/sync-firestore-mirror.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/sync-firestore-mirror.log</string>
</dict>
</plist>
