<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.parse-notifications-to-vault</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>parse-notifications-to-vault</string>
  </array>
  <!-- 10분 간격(2026-08-28, 오너 지시 — 평일 16:00 하루 1회→상시 10분 간격). 이 잡은
       LLM 호출이 없는 순수 Node 파싱(정규식)+Firestore 읽기/쓰기라 빈도를 올려도
       토큰 비용이 전혀 없다 — sync-firestore-mirror·update-holdings-prices·update-
       allocation-from-holdings와 동일 StartInterval=600 패턴으로 맞춘다. 요일 제한
       없이 상시 실행(kakaoInbox가 비어있으면 그냥 조용히 끝남, 파일명 dedup이 안전망).
       기존 "daily-asset-allocation-check(16:30)보다 30분 먼저"라는 순서 의존은 이제
       상시 갱신이라 더 이상 의미 없음(항상 그 시점 최신 상태). -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Stockproject/banana-portfolio-v2</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/parse-notifications-to-vault.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/parse-notifications-to-vault.log</string>
</dict>
</plist>
