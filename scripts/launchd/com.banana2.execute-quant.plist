<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.execute-quant</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>execute-quant</string>
  </array>
  <!-- 승인된 퀀트 제안의 "장중/장마감 후 재시도" 정책(오너 지시, 2026-08-13) — 상시
       텔레그램 세션(Zeus)이 승인 직후 1회 실행하는 것에만 의존하면, 그 시도가
       checkMarketOpen(장외시간)이나 checkPriceDeviation(가격이탈) 등에 막혔을 때 아무도
       다시 시도하지 않는 갭이 있었다. 5분마다 무조건 돌리되(대상 없으면 로컬 파일만
       읽고 즉시 종료 — KIS API 호출 자체가 없어 장외시간에도 비용이 사실상 0), 장이
       열리면 checkMarketOpen이 자연히 통과시켜 "장마감 후 승인 → 다음 개장 때 자동
       재시도"가 별도 로직 없이 같은 경로로 처리된다. 차단 사유가 바뀔 때만 텔레그램
       알림(execute-quant-proposal.mjs 참고) — 5분마다 알림 스팸 방지. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Stockproject/banana-portfolio-v2</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/execute-quant.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/execute-quant.log</string>
</dict>
</plist>
