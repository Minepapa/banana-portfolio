<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.weekly-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>weekly-report</string>
