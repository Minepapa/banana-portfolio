<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.health-watcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Stockproject/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>health-watcher</string>
  </array>
  <!-- 다른 잡·상시 세션과 완전히 독립적으로 30분마다 하트비트 정체·세션 생존을 점검
       (docs/ARCHITECTURE-V2.md "장애감지 — 독립 워처 + 하트비트" 절) -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Stockproject/banana-portfolio-v2</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/health-watcher.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/health-watcher.log</string>
</dict>
</plist>
