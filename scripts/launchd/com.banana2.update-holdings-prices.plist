<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.update-holdings-prices</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Pantheon/Repos/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>update-holdings-prices</string>
  </array>
  <!-- 10분 간격(2026-08-25, 오너 지시 — 30분→10분 단축). 여전히 v1 com.banana.
       realtime-quotes(30초 간격, KIS 레이트리밋 회피 목적의 초단위 폴링)보다는
       느슨하다 — 종목 하나당 800ms 스태거로 순차조회하는 실행시간 자체가 보통
       10초 안팎(로그 실측)이라 10분 간격에서도 겹쳐 돌 위험은 없고, KIS는 초당
       호출빈도가 문제지 총 호출횟수 자체에 별도 과금이 없는 무료 API라 하루 총
       호출량이 3배(48회→144회) 늘어도 비용 문제는 없다. 장중·장외 여부는 스케줄이
       아니라 잡 자체(isKrMarketOpen/isUsMarketOpen)가 내부에서 판단 — 24시간 내내
       이 간격으로 돌아도 장외엔 KR/US 조회를 스스로 스킵한다(금현물만 예외 — KRX
       일별배치라 애초에 장중·장외 구분이 의미 없음, 그날 데이터가 아직 미발행이면
       그냥 어제 값 그대로 반복 조회될 뿐 문제 없음). -->
  <!-- 2026-10-29 오너 지시("API 호출이 충돌나지 않게 분배") — StartInterval=600(로드 시점에
       따라 위상이 제멋대로)을 매시 :00·:10·…·:50 고정 분으로 바꿨다. 같은 10분 주기인
       intraday-market-move-monitor(:03…)·intraday-portfolio-sync(:05…)와 분을 엇갈려
       NH·KIS를 같은 순간에 부르지 않게 한다(이 잡 실행시간 중앙값 12초). 채권·금·펀드 같은
       느린 값은 :00 회차에만 조회한다(scripts/lib/poll-schedule.mjs). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>10</integer></dict>
    <dict><key>Minute</key><integer>20</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>40</integer></dict>
    <dict><key>Minute</key><integer>50</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Pantheon/Repos/banana-portfolio-v2</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/update-holdings-prices.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/update-holdings-prices.log</string>
</dict>
</plist>
