<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.banana2.telegram-gate</string>
  <!-- 텔레그램 관문(2026-10-30 관문 1단계, 결정 `텔레그램-관문` 초안) — 봇의 유일한 수신·발신자인 상시 데몬.
       ⚠️ 4단계 전환(주말 오전, 오너 입회) 전에는 설치·등록하지 않는다. 봇 토큰당 getUpdates 소비자는 하나뿐이라
       상시 세션(com.banana2.telegram-session)이 떠 있는 동안 이 잡을 올리면 그 세션의 수신을 빼앗는다.
       전환 절차·되돌리기는 볼트 Requests "2026-10-30 텔레그램 관문 설계" 11-2.
       대화형 TUI가 아니라 Node 데몬이라 /usr/bin/script 가짜 TTY가 필요 없다. run.sh가 PATH(/usr/local/bin 우선)와
       --no-network-family-autoselection을 맞추고, claude 경로는 resolveClaudeBin()이 ~/.local/bin/claude를 고른다.
       데몬 안의 감시견이 멈춤을 감지하면 exit(1) → KeepAlive가 다시 띄운다. 바깥 감시는 telegram-gate-health-check(10분). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/huinique/Pantheon/Repos/banana-portfolio-v2/scripts/launchd/run.sh</string>
    <string>telegram-gate</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>WorkingDirectory</key>
  <string>/Users/huinique/Pantheon/Repos/banana-portfolio-v2</string>
  <key>StandardOutPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/telegram-gate.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/huinique/Library/Logs/banana-portfolio-v2/telegram-gate.log</string>
</dict>
</plist>
